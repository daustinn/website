---
import Experiences from '@/components/experiences.astro'
import Hero from '@/components/hero.astro'
import Projects from '@/components/projects.astro'
import { LANGUAGES } from '@/const'
import Root from '@/layouts/root.astro'
import { t } from '@/translations'

export function getStaticPaths() {
  return LANGUAGES.map((locale) => ({ params: { locale } }))
}

const { locale } = Astro.params as { locale: 'es' | 'en' }
const title = t('seo.title', Astro.url)
const description = t('seo.description', Astro.url)
const keywords = t('seo.keywords', Astro.url)
---

<Root
  locale={locale}
  title={title}
  description={description}
  keywords={keywords}
>
  <Hero />
  <Experiences />
  <Projects />
</Root>
