---
import Github from '@/assets/github.svg'
import Globe from '@/assets/globe.svg'
import X from '@/assets/x.svg'
import { t, getLocaleByUrl, toggleLocale } from '@/translations'

import { DAUSTINN, LANGUAGES } from '@/const'

const locale = getLocaleByUrl(Astro.url)
---

<header class="pt-5 md:pt-20">
  <nav class="container flex">
    <div class="grow">
      <h1 class="text-xl font-young-serif font-normal">Daustinn.</h1>
      <h2 class="tracking-tight font-semibold opacity-60">
        {t('role', Astro.url)}
      </h2>
    </div>
    <div
      class="flex items-center [&>a]:hover:scale-110 [&>a]:transition-transform [&>a]:px-3 [&>a]:inline-flex"
    >
      <a href={DAUSTINN.githubURL} target="_blank" rel="noopener noreferrer">
        <Github width={19} />
      </a>
      <a href={DAUSTINN.xURL} target="_blank" rel="noopener noreferrer">
        <X width={19} />
      </a>
      <a
        href={toggleLocale(Astro.url)}
        class="font-semibold text-sm flex gap-1"
        data-toggle-locale={toggleLocale(Astro.url)
          .replace(/^\//, '')
          .split('/')[0]}
      >
        <Globe width={19} />
        {
          LANGUAGES.map((lang) => (
            <span
              {...(lang === locale ? { 'data-current': '' } : {})}
              class="hidden data-current:block"
            >
              {lang.toUpperCase()}
            </span>
          ))
        }
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLAnchorElement>(
    '[data-toggle-locale]'
  )
  toggle?.addEventListener('click', () => {
    const next = toggle.dataset.toggleLocale
    if (next) localStorage.setItem('locale', next)
  })
</script>
