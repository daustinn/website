---
import { t, getLocaleByUrl, href } from '@/translations'

export type Props = {
  isHome?: boolean
}

const { isHome = false } = Astro.props
const locale = getLocaleByUrl(Astro.url)
const navLabel = locale === 'es' ? 'Navegación principal' : 'Main navigation'
---

<header class="pt-5 lg:pt-20">
  <nav class="container flex" aria-label={navLabel}>
    <div class="grow">
      <a href={href(Astro.url, '/')} class="hover:underline">
        <span class="text-xl font-medium"> Daustinn. </span>
      </a>
      {
        isHome ? (
          <h1 class="tracking-tight text-lg font-medium opacity-60">
            {t('role', Astro.url)}
          </h1>
        ) : (
          <p class="tracking-tight text-lg font-medium opacity-60">
            {t('role', Astro.url)}
          </p>
        )
      }
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLAnchorElement>(
    '[data-toggle-locale]'
  )
  toggle?.addEventListener('click', () => {
    const next = toggle.dataset.toggleLocale
    if (next) localStorage.setItem('locale', next)
  })
</script>
