---
import '@/styles/global.css'
import Header from '@/components/header.astro'
import { seoConfig, getJsonLd } from '@/const/seo'
import Footer from '@/components/footer.astro'

export type Props = {
  title?: string
  description?: string
  keywords?: string
  locale?: 'en' | 'es'
}

const {
  locale = 'en',
  title = seoConfig.defaultTitle,
  description = seoConfig.defaultDescription,
  keywords = seoConfig.defaultKeywords
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, seoConfig.url).toString()
const ogLocale = locale === 'es' ? 'es_PE' : 'en_US'
const ogLocaleAlternate = locale === 'es' ? 'en_US' : 'es_PE'
const ogImageURL = `${seoConfig.url}${seoConfig.ogImage}`
const jsonLd = getJsonLd({
  url: canonicalURL,
  title,
  description,
  locale
})
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link
      rel="preload"
      href="/young-serif.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={seoConfig.author} />
    <meta name="creator" content={seoConfig.author} />
    <meta name="publisher" content={seoConfig.author} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta
      name="googlebot"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="theme-color" content={seoConfig.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="application-name" content={seoConfig.siteName} />
    <meta name="apple-mobile-web-app-title" content={seoConfig.siteName} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <!-- Canonical and Alternate Languages -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={`${seoConfig.url}/en`} />
    <link rel="alternate" hreflang="es" href={`${seoConfig.url}/es`} />
    <link rel="alternate" hreflang="x-default" href={seoConfig.url} />

    <link rel="icon" href="/favicon.avif" type="image/avif" />
    <link rel="apple-touch-icon" href="/favicon.avif" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={seoConfig.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:type" content={seoConfig.ogImageType} />
    <meta
      property="og:image:width"
      content={seoConfig.ogImageWidth.toString()}
    />
    <meta
      property="og:image:height"
      content={seoConfig.ogImageHeight.toString()}
    />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={seoConfig.twitter} />
    <meta name="twitter:creator" content={seoConfig.twitter} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-svh flex flex-col">
    <Header />
    <main class="grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
